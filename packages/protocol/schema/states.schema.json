{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "states.schema.json",
  "title": "상태 enum — crates/statechart/machines/wire.yaml 에서 생성 (손으로 고치지 않는다)",
  "$comment": "GENERATED by lodelai-protocol-gen: lodelai-statechart(= crates/statechart/machines/wire.yaml) 의 enum 값에서 만든다. Rust 는 lodelai-statechart 를 re-export 하고, TS 는 이 파일에서 생성한다.",
  "$defs": {
    "RecipientState": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "queued",
        "injected",
        "consumed",
        "drafted",
        "replied",
        "rejected",
        "aborted",
        "discarded",
        "expired",
        "failed",
        "held",
        "withdrawn",
        "done",
        "unreadable"
      ],
      "description": "wire.yaml machines[name=request_recipient].states[*].name"
    },
    "SenderViewState": {
      "type": "string",
      "enum": [
        "sent",
        "stored",
        "received",
        "pending",
        "accepted",
        "failed",
        "consumed",
        "replied",
        "rejected",
        "aborted",
        "expired",
        "done",
        "withdrawn"
      ],
      "description": "wire.yaml machines[name=request_sender_view].states[*].name"
    },
    "EnvelopeState": {
      "type": "string",
      "enum": ["stored", "device_received", "expired"],
      "description": "wire.yaml machines[name=envelope_server].states[*].name"
    },
    "AbortReason": {
      "type": "string",
      "enum": ["turn_ended", "owner_aborted", "session_exited", "mode_escalated", "draft_discarded", "needs_task"],
      "description": "wire.yaml machines[name=request_recipient].abort_reasons"
    }
  }
}
